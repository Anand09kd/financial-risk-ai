models/*.onnx
!models/.gitkeep

# ============================================
# Vector Store (RAG index)
# ============================================
vector_store/*
!vector_store/.gitkeep

# ============================================
# Data (don't commit user data)
# ============================================
data/processed/*
!data/processed/.gitkeep

data/uploads/*
!data/uploads/.gitkeep

# Optional: keep sample raw data, ignore rest
data/raw/*.csv
!data/raw/sample_financial_data.csv
!data/raw/.gitkeep

